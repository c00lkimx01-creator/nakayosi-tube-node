{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/yt/(.*)", "dest": "api/index.js" },
    { "src": "/api-proxy", "dest": "api/index.js" },
    { "src": "/download/zip", "dest": "api/index.js" },
    { "src": "/healthz", "dest": "api/index.js" },
    { "src": "/(css|js|instances)/(.*)", "dest": "/public/$1/$2" },
    { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  }
}
